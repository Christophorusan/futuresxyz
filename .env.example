# Public browser key: restrict allowed domains and set usage limits in Alchemy.
VITE_ALCHEMY_API_KEY=
# Optional, public policy identifier. Configure target/function allowlists and spending caps.
VITE_ALCHEMY_GAS_POLICY_ID=

# Enable only after verifying wallet compatibility and successful HyperEVM calls.
VITE_ALCHEMY_SMART_WALLETS_ENABLED=false

# Reown project ID for WalletConnect mobile pairing (public identifier).
VITE_WALLETCONNECT_PROJECT_ID=

# Public Privy app ID. Enable email in the Privy dashboard before setting this.
VITE_PRIVY_APP_ID=
# Enable only after configuring X OAuth in Privy.
VITE_PRIVY_X_ENABLED=false

# Public URL of your deployed Across proxy (API key stays on its server).
VITE_ACROSS_PROXY_URL=
